{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MAXINE Evidence Record",
  "type": "object",
  "required": ["id", "front", "claim", "evidence_level", "sources", "tags"],
  "properties": {
    "id": {"type": "string"},
    "front": {"enum": ["F1", "F2", "F3"]},
    "subject": {"type": ["string", "null"]},
    "claim": {"type": "string"},
    "mechanism": {"type": ["string", "null"]},
    "evidence_level": {"enum": ["A", "B", "C"]},
    "quantitative": {"type": ["object", "null"]},
    "limitations": {"type": ["string", "null"]},
    "contradictions": {"type": ["array", "null"], "items": {"type": "string"}},
    "maturity": {"type": ["string", "null"]},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {"type": "string"},
          "authors": {"type": ["string", "null"]},
          "year": {"type": ["integer", "null"]},
          "doi": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"]},
          "source_type": {"type": ["string", "null"]}
        }
      }
    }
  },
  "additionalProperties": true
}
